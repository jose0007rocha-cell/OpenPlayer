<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Fundo escuro estilo grafite (igual ao print) -->
    <solid android:color="#1E1E22" />
    
    <!-- Cantos bem arredondados -->
    <corners android:radius="24dp" />
    
    <!-- Borda bem fininha e sutil (cinza claro com transparência) -->
    <stroke android:width="1dp" android:color="#3D3D40" />
    
</shape>