<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#17181D" />
        </shape>
    </item>
    <!-- facho de luz vindo de cima -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.0"
                android:endColor="#00000000"
                android:gradientRadius="95%p"
                android:startColor="#3A4152"
                android:type="radial" />
        </shape>
    </item>
    <!-- brilho suave no "chão", abaixo do ícone -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.62"
                android:endColor="#00000000"
                android:gradientRadius="55%p"
                android:startColor="#2A2F3D"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
