<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_back"
                android:tint="?attr/colorOnSurface" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/themes"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/bg_title"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/bgPreview"
            android:layout_width="170dp"
            android:layout_height="340dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_portrait"
            android:clipToOutline="true"
            android:contentDescription="@string/bg_pick"
            android:scaleType="center"
            android:src="@drawable/ic_add_image" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBgPick"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bg_pick" />

            <Button
                android:id="@+id/btnBgRemove"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bg_remove"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/dimLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/bg_dim"
            android:textSize="13sp"
            android:visibility="gone" />

        <SeekBar
            android:id="@+id/sliderDim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="18"
            android:maxHeight="32dp"
            android:minHeight="32dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/blurLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bg_blur"
            android:textSize="13sp"
            android:visibility="gone" />

        <SeekBar
            android:id="@+id/sliderBlur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20"
            android:maxHeight="32dp"
            android:minHeight="32dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAmoled"
            android:minHeight="48dp"
            android:textSize="16sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/amoled" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/accent_title"
            android:textSize="14sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/accentGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="5" />
    </LinearLayout>
</ScrollView>
